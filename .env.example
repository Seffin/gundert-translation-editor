# =========================================================================
# Gundert Translation Editor - Environment Variables Template
# Copy this file to '.env' and fill in your secrets.
# =========================================================================

# Gemini API Key for AI-assisted drafting and consistency checks
# Acquire this from Google AI Studio (https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Turso/libSQL cloud or local SQLite/JSON fallbacks)
# - To use Turso cloud, set both TURSO_DB_URL and TURSO_DB_TOKEN.
#   Example URL: libsql://gundert-db-yourusername.turso.io
# - Leave TURSO_DB_URL blank to fall back to a local SQLite database (data/gundert.db)
TURSO_DB_URL=
TURSO_DB_TOKEN=

# Source File Link Configuration
# Template URL for fetching original OBS stories dynamically if local files are missing.
# Keep the '{storyId}' placeholder intact; SvelteKit will replace it at runtime.
SOURCE_FILE_URL_TEMPLATE=https://git.door43.org/unfoldingWord/en_obs/raw/branch/master/content/{storyId}.md

# GitHub Contents API Integration Configuration (for automatic publishing on Lead Approval)
# Configure these to automatically commit approved translations to your GitHub repository.
GITHUB_PAT=your_github_personal_access_token
GITHUB_REPO_OWNER=your_github_username_or_organization
GITHUB_REPO_NAME=your_github_repository_name

# Google OAuth 2.0 Configuration
# Set these to enable real Google Sign-In. If left blank, the app will fall back to the Simulator sandbox.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

